{
  "custom": {
    "bareFallback": "${sls:stage}",
    "bucket": "app-acme-prod-ui-${aws:accountId}-${aws:region}",
    "frameworkStage": "${sls:stage}",
    "inFallback": "prefix-${sls:stage}-${ssm:/app/x}",
    "principalTagArn": "arn:aws:s3:::bucket/${aws:PrincipalTag/team}/*",
    "ssmKey": "${ssm:/app/acme-prod/key}",
    "stackOutput": "${cf:other-stack-acme-prod.ApiUrl}"
  },
  "provider": {
    "name": "aws",
    "stage": "acme-prod"
  },
  "service": "passthrough"
}
