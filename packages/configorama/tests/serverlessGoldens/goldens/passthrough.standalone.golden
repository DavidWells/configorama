{
  "custom": {
    "bareFallback": "${sls:stage}",
    "bucket": "app-qa-ui-${aws:accountId}-${aws:region}",
    "frameworkStage": "${sls:stage}",
    "inFallback": "prefix-${sls:stage}-${ssm:/app/x}",
    "principalTagArn": "arn:aws:s3:::bucket/${aws:PrincipalTag/team}/*",
    "ssmKey": "${ssm:/app/qa/key}",
    "stackOutput": "${cf:other-stack-qa.ApiUrl}"
  },
  "provider": {
    "name": "aws",
    "stage": "qa"
  },
  "service": "passthrough"
}
